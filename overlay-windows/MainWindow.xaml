<Window x:Class="HireSky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HireSky"
        Width="420" Height="300"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" 
                      CornerRadius="0" 
                      CaptionHeight="0" 
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <!-- Glassmorphism card -->
    <Border CornerRadius="16"
            Margin="12"
            BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.BorderBrush>
            <SolidColorBrush Color="#33FFFFFF"/>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E60B0D12" Offset="0"/>
                <GradientStop Color="#E6151A24" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#EF4444"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="connecting…" Margin="6,0,0,0"
                               Foreground="#BFC6D4" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ToggleTranscriptBtn" Text="➖" Foreground="#8B93A7" FontSize="10" Margin="0,0,8,0"
                               Cursor="Hand" MouseLeftButtonDown="ToggleTranscript_Click" VerticalAlignment="Center"/>
                    <TextBlock Text="SystemAudioBridge" Foreground="#F2F4F8" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Streaming answer -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <TextBlock x:Name="AnswerText" Text="" TextWrapping="Wrap"
                           Foreground="#FAFBFE" FontSize="14" LineHeight="20"/>
            </ScrollViewer>

            <!-- Latest transcript line -->
            <TextBlock Grid.Row="2" x:Name="TranscriptText" Text="" TextWrapping="Wrap"
                       Foreground="#8B93A7" FontSize="11" MaxHeight="34" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>

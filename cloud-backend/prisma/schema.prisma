// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
// Identity Engine
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  role           String    @default("USER") // USER, ADMIN
  status         String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  emailVerified  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?

  profile        Profile?
  userContext    UserContext?
  resumes        Resume[]
  jobDescriptions JobDescription[]
  calendarEvents CalendarEvent[]
  subscriptions  Subscription[]
  entitlements   UserEntitlement[]
  sessions       InterviewSession[]
  metrics        InterviewMetrics?
  leaderboardEntries LeaderboardEntry[]
  notifications  Notification[]
  referralCode   ReferralCode?
  referralsMade  Referral[]  @relation("ReferrerRelation")
  referredBy     Referral?   @relation("ReferredRelation")
  adminLogs      AdminLog[]
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  firstName       String?
  lastName        String?
  phone           String?
  avatarUrl       String?
  bio             String?
  location        String?
  experienceYears Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Billing Engine
// -----------------------------------------------------------------------------

model Plan {
  id            String   @id @default(uuid())
  name          String   // e.g. "HR Day", "Technical Monthly"
  domain        String   // "HR", "TECHNICAL", "CODING"
  durationHours Int?     // e.g. 24 for daily, null for monthly
  price         Decimal
  currency      String   @default("USD")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String    @id @default(uuid())
  userId                 String
  planId                 String
  status                 String    // "active", "past_due", "cancelled", "expired"
  startedAt              DateTime
  expiresAt              DateTime?
  autoRenew              Boolean   @default(true)
  provider               String?   // "stripe", "razorpay"
  providerSubscriptionId String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id])
  plan         Plan              @relation(fields: [planId], references: [id])
  entitlements UserEntitlement[]
}

model UserEntitlement {
  id             String    @id @default(uuid())
  userId         String
  subscriptionId String
  featureKey     String    // e.g. "live_interview", "transcription"
  enabled        Boolean   @default(true)
  limitValue     Int?      // e.g. max interviews
  startsAt       DateTime
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
}

// -----------------------------------------------------------------------------
// Interview Engine
// -----------------------------------------------------------------------------

model InterviewSession {
  id              String    @id @default(uuid())
  userId          String
  title           String?
  domain          String    // "HR", "TECHNICAL", "CODING"
  interviewType   String?
  companyName     String?
  jobTitle        String?
  status          String    @default("scheduled") // "scheduled", "active", "completed", "cancelled"
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  videoUrl        String?   // Added in Phase 3
  audioUrl        String?   // Added in Phase 3
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  
  // Relations to transcripts and summaries
  transcriptSegments TranscriptSegment[]
  summary            InterviewSummary?
  contextSnapshot    SessionContextSnapshot?
}

model TranscriptSegment {
  id          String   @id @default(uuid())
  sessionId   String
  speaker     String   // "interviewer", "candidate"
  text        String
  startTime   String?  // e.g. "00:02:31"
  endTime     String?
  sequence    Int
  confidence  Float?
  createdAt   DateTime @default(now())

  session     InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// AI Engine (Simplified for Phase 1)
// -----------------------------------------------------------------------------

model InterviewSummary {
  id                 String   @id @default(uuid())
  sessionId          String   @unique
  overallScore       Float?
  technicalScore     Float?
  communicationScore Float?
  confidenceScore    Float?
  summary            String?
  strengths          String?
  weaknesses         String?
  areasToImprove     String?
  recommendations    String?
  fillerWordCount    Int?     // Added in Phase 3
  speakingPaceWpm    Int?     // Added in Phase 3
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  session            InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Context & Profile Engine (Phase 2)
// -----------------------------------------------------------------------------

model UserContext {
  id                  String   @id @default(uuid())
  userId              String   @unique
  targetRole          String?
  targetCompanies     String?
  preferredAnswerStyle String? // e.g. "Concise, Technical, Production-focused"
  technicalStack      String? // e.g. "React, Node.js, PostgreSQL"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id          String   @id @default(uuid())
  userId      String
  fileName    String
  storageKey  String?
  extractedText String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobDescription {
  id              String   @id @default(uuid())
  userId          String
  title           String?
  company         String?
  descriptionText String
  extractedSkills String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Calendar Engine (Phase 2)
// -----------------------------------------------------------------------------

model CalendarEvent {
  id            String   @id @default(uuid())
  userId        String
  title         String
  company       String?
  role          String?
  domain        String?  // HR, TECHNICAL, etc.
  startTime     DateTime
  endTime       DateTime
  meetingUrl    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Snapshot & Analytics Engine (Phase 2)
// -----------------------------------------------------------------------------

model SessionContextSnapshot {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  contextJson String   // Snapshot of User, Job, and Profile context at start time
  createdAt   DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InterviewMetrics {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalInterviews Int      @default(0)
  averageScore    Float?
  strongestArea   String?
  weakestArea     String?
  trendValue      Float?   // e.g. +14.0
  lastCalculatedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Leaderboard Engine (Phase 3)
// -----------------------------------------------------------------------------

model GlobalLeaderboard {
  id        String   @id @default(uuid())
  epochName String   // e.g. "ALL_TIME", "MONTHLY_OCT_26"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries   LeaderboardEntry[]
}

model LeaderboardEntry {
  id             String   @id @default(uuid())
  leaderboardId  String
  userId         String
  rank           Int
  score          Float
  totalInterviews Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leaderboard    GlobalLeaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([leaderboardId, userId])
}

// -----------------------------------------------------------------------------
// Notifications Engine (Phase 4)
// -----------------------------------------------------------------------------

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String   // "INTERVIEW_COMPLETE", "REFERRAL_REWARD", "PLAN_EXPIRY", "SYSTEM"
  title      String
  message    String
  isRead     Boolean  @default(false)
  actionUrl  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Referral Engine (Phase 4)
// -----------------------------------------------------------------------------

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique
  code      String   @unique
  usedCount Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  status         String   @default("PENDING") // PENDING, REWARDED
  rewardDays     Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referrer     User @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referredUser User @relation("ReferredRelation", fields: [referredUserId], references: [id])
}

// -----------------------------------------------------------------------------
// Admin Engine (Phase 4)
// -----------------------------------------------------------------------------

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   // e.g. "BAN_USER", "EDIT_PLAN", "GRANT_ENTITLEMENT"
  targetId   String?  // userId or entityId being acted on
  details    String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])
}
